PORT=3000
NODE_ENV=development

# URLs públicas (sin "/" al final)
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cliente OAuth de Google (el mismo que configuraste en Supabase → Auth → Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 bytes en base64 para cifrar los refresh tokens de Drive:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Solo producción con frontend y backend en dominios distintos:
# COOKIE_SAMESITE=none
# Si comparten dominio padre (app.midominio.com y api.midominio.com):
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.midominio.com

# --- Preset para Render (frontend y backend en dominios onrender.com distintos) ---
# El Static Site reenvía /api/* y /auth/* al backend (ver README), así que
# API_URL apunta al FRONTEND:
# NODE_ENV=production
# CLIENT_URL=https://mi-front.onrender.com
# API_URL=https://mi-front.onrender.com
# COOKIE_SAMESITE=lax
